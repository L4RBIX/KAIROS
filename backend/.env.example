# DeepSeek Copilot (server-side only — never put these in Vite/.env)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=25
DEEPSEEK_MAX_TOKENS=450

# Optional overrides
# KAIROS_MODEL_DIR=model/BORAN_MODEL
# KAIROS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
